        "request_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "reset_epoch": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "reset_verified": {
          "const": true
        },
        "result_count": {
          "maximum": 4294967295,
