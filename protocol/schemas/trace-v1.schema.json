            "bodies",
            "fixtures",
            "joints",
            "contacts",
            "particle_systems",
            "particle_groups",
            "particles"
          ],
          "type": "object"
        }
      },
      "required": [
        "protocol_version",
        "record_kind",
        "request_id",
        "checkpoint_id",
        "ordinal",
        "phase",
        "simulation_time_bits",
        "world_counts",
        "identity_sha256"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "checkpoint_count": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "type": "integer"
        },
        "record_kind": {
          "const": "trace_end"
        },
        "request_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "reset_epoch": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
