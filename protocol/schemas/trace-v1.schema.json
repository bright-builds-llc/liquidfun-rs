              "class": {
                "enum": [
                  "zero",
                  "subnormal",
                  "normal",
                  "infinite",
                  "nan"
                ]
              },
              "field": {
                "enum": [
                  "value",
                  "x",
                  "y",
                  "z",
                  "length",
                  "sine",
                  "cosine",
                  "position_x",
                  "position_y",
                  "angle",
                  "initial_center_x",
                  "initial_center_y",
                  "initial_angle",
                  "initial_fraction",
                  "left_associated",
                  "right_associated",
                  "even_midpoint",
                  "odd_midpoint"
                ]
              },
              "negative": {
                "type": "boolean"
              }
            },
            "required": [
              "field",
              "bits",
              "class",
              "negative"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "operation",
        "policy_path",
        "horizon",
        "values",
        "discrete"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "collection_policy": {
          "enum": [
            "ordered",
            "set"
          ]
        },
        "horizon": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "operation"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "phase_local"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        },
        "operation": {
          "enum": [
            "shape_construction",
            "shape_unary_query",
            "distance",
            "overlap",
            "clip",
            "manifold",
            "pair_dispatch",
            "feature_transition",
            "tree_lifecycle",
            "tree_query",
            "tree_ray",
            "tree_metrics",
            "broad_phase_move_touch",
            "broad_phase_pairs",
            "broad_phase_filter",
            "broad_phase_refilter",
            "time_of_impact"
          ]
        },
        "outcome": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "discrete": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "maxLength": 4096,
                        "minLength": 1,
                        "type": "string"
                      },
                      "value": {
                        "maxLength": 4096,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "type": "object"
                  },
                  "maxItems": 128,
                  "type": "array"
                },
                "kind": {
                  "const": "accepted"
                },
                "numeric": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "bits": {
                        "maximum": 4294967295,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "field": {
                        "maxLength": 4096,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "bits"
                    ],
                    "type": "object"
                  },
                  "maxItems": 128,
                  "type": "array"
                },
                "payload_ids": {
                  "items": {
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 128,
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "numeric",
                "discrete",
                "payload_ids"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "enum": [
