                "field": {
                  "enum": [
                    "circle_center",
                    "circle_radius",
                    "edge_start",
                    "edge_end",
                    "edge_previous",
                    "edge_next",
                    "polygon_vertices",
                    "chain_vertices",
                    "child_index"
                  ]
