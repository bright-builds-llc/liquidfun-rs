{
  "$id": "https://liquidfun-rs.invalid/protocol/schemas/scenario-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic presentation only. Typed Rust and C++ validation remains authoritative for cross-field references, uniqueness, ordering, hashes, and aggregate limits.",
  "properties": {
    "checkpoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after_command_id": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "checkpoint_id": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "observables": {
            "items": {
              "enum": [
                "world_counts",
                "simulation_time"
              ]
            },
            "maxItems": 128,
            "type": "array"
          },
          "phase": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "checkpoint_id",
          "after_command_id",
          "phase",
          "observables"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "const": "step"
          },
          "particle_iterations": {
            "maximum": 255,
            "minimum": 1,
            "type": "integer"
          },
          "position_iterations": {
            "maximum": 255,
            "minimum": 1,
            "type": "integer"
          },
          "timestep_bits": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "velocity_iterations": {
            "maximum": 255,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "command_id",
          "timestep_bits",
          "velocity_iterations",
          "position_iterations",
          "particle_iterations"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    },
    "entities": {
      "items": false,
      "maxItems": 0,
      "type": "array"
    },
    "gravity_x_bits": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "gravity_y_bits": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "scenario_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "source": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "named"
            },
            "name": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "generator_id": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "generator_version": {
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            },
            "kind": {
              "const": "seeded"
            },
            "seed": {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "generator_id",
            "generator_version",
            "seed"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "scenario_id",
    "source",
    "gravity_x_bits",
    "gravity_y_bits",
    "entities",
    "commands",
    "checkpoints"
  ],
  "title": "liquidfun-rs scenario presentation version 1",
  "type": "object",
  "x-version-axes": {
    "scenario_schema_version": 1
  }
}
