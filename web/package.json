{
  "name": "liquidfun-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify:kobalte-licenses": "bun scripts/verify-kobalte-licenses.ts",
    "test:unit": "vitest run",
    "build:app": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "demo-media": "bun scripts/demo-media.ts",
    "test:browser": "playwright test",
    "test:player": "playwright test e2e/player.spec.ts e2e/demo-media-clock.spec.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@kobalte/core": "0.13.12",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  }
}
