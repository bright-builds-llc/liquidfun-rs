cmake_minimum_required(VERSION 3.25)

set(COMPILE_DATABASE "@CMAKE_BINARY_DIR@/compile_commands.json")
set(OUTPUT_HEADER "@REFERENCE_BUILD_IDENTITY_HEADER@")
set(D1_CANDIDATE "@REFERENCE_D1_CANDIDATE@")

if(NOT EXISTS "${COMPILE_DATABASE}")
  message(FATAL_ERROR "effective compile database is unavailable: ${COMPILE_DATABASE}")
endif()

file(READ "${COMPILE_DATABASE}" COMPILE_DATABASE_JSON)
string(JSON COMPILE_ENTRY_COUNT LENGTH "${COMPILE_DATABASE_JSON}")
set(PROBE_COMMANDS "")
if(COMPILE_ENTRY_COUNT GREATER 0)
  math(EXPR LAST_COMPILE_ENTRY "${COMPILE_ENTRY_COUNT} - 1")
  foreach(INDEX RANGE 0 ${LAST_COMPILE_ENTRY})
    string(JSON SOURCE_FILE GET "${COMPILE_DATABASE_JSON}" ${INDEX} file)
    if(NOT SOURCE_FILE MATCHES "[/\\](math_probe|protocol_bits)\\.cpp$")
      continue()
    endif()
    string(JSON EFFECTIVE_COMMAND ERROR_VARIABLE COMMAND_ERROR GET "${COMPILE_DATABASE_JSON}" ${INDEX} command)
    if(COMMAND_ERROR)
      string(JSON ARGUMENT_COUNT LENGTH "${COMPILE_DATABASE_JSON}" ${INDEX} arguments)
      set(EFFECTIVE_COMMAND "")
      if(ARGUMENT_COUNT GREATER 0)
        math(EXPR LAST_ARGUMENT "${ARGUMENT_COUNT} - 1")
        foreach(ARGUMENT_INDEX RANGE 0 ${LAST_ARGUMENT})
          string(JSON ARGUMENT GET "${COMPILE_DATABASE_JSON}" ${INDEX} arguments ${ARGUMENT_INDEX})
          string(APPEND EFFECTIVE_COMMAND "${ARGUMENT}\n")
        endforeach()
      endif()
    endif()
    set(NORMALIZED_SOURCE_FILE "${SOURCE_FILE}")
    set(NORMALIZED_COMMAND "${EFFECTIVE_COMMAND}")
    foreach(
      PATH_REPLACEMENT
      IN ITEMS
        "@CMAKE_BINARY_DIR@|<build>"
        "@REFERENCE_REPOSITORY_ROOT@|<repo>"
    )
      string(REPLACE "|" ";" PATH_REPLACEMENT_PARTS "${PATH_REPLACEMENT}")
      list(GET PATH_REPLACEMENT_PARTS 0 RAW_PATH)
      list(GET PATH_REPLACEMENT_PARTS 1 PLACEHOLDER)
      string(REPLACE "${RAW_PATH}" "${PLACEHOLDER}" NORMALIZED_SOURCE_FILE "${NORMALIZED_SOURCE_FILE}")
      string(REPLACE "${RAW_PATH}" "${PLACEHOLDER}" NORMALIZED_COMMAND "${NORMALIZED_COMMAND}")
    endforeach()
    list(APPEND PROBE_COMMANDS "${NORMALIZED_SOURCE_FILE}\n${NORMALIZED_COMMAND}")
  endforeach()
endif()

list(LENGTH PROBE_COMMANDS PROBE_COMMAND_COUNT)
if(NOT PROBE_COMMAND_COUNT EQUAL 2)
  message(FATAL_ERROR "expected exactly two effective math/probe compile commands, found ${PROBE_COMMAND_COUNT}")
endif()
list(SORT PROBE_COMMANDS)
string(JOIN "\n" EFFECTIVE_COMPILE_COMMANDS ${PROBE_COMMANDS})

set(FORBIDDEN_PATTERN "(^|[ ;\\n])(-ffast-math|-Ofast|-fassociative-math|-freciprocal-math|-funsafe-math-optimizations|-march=[^ ;\\n]+|-mcpu=[^ ;\\n]+|-mtune=[^ ;\\n]+|-mavx[^ ;\\n]*|-mfma|-msse[^ ;\\n]*|-mllvm|-Xclang)($|[ ;\\n])|unsafe-fp|no-nans-fp|no-infs-fp|fp-contract=(fast|on)")
if(EFFECTIVE_COMPILE_COMMANDS MATCHES "${FORBIDDEN_PATTERN}" AND D1_CANDIDATE)
  message(FATAL_ERROR "canonical effective compile command contains forbidden floating/native flags")
endif()

string(SHA256 COMPILE_COMMAND_SHA256 "${EFFECTIVE_COMPILE_COMMANDS}")

function(escape_cpp_string INPUT_VALUE OUTPUT_VARIABLE)
  string(REPLACE "\\" "\\\\" ESCAPED_VALUE "${INPUT_VALUE}")
  string(REPLACE "\"" "\\\"" ESCAPED_VALUE "${ESCAPED_VALUE}")
  string(REPLACE "\n" "\\n" ESCAPED_VALUE "${ESCAPED_VALUE}")
  string(REPLACE "\r" "\\r" ESCAPED_VALUE "${ESCAPED_VALUE}")
  set("${OUTPUT_VARIABLE}" "${ESCAPED_VALUE}" PARENT_SCOPE)
endfunction()

file(WRITE "${OUTPUT_HEADER}" "#pragma once\n\n")
file(APPEND "${OUTPUT_HEADER}" "// Generated at build time from the effective compile database.\n")
file(APPEND "${OUTPUT_HEADER}" "namespace liquidfun::reference::configured_build_identity {\n\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kOracleRevision[] = \"@REFERENCE_ORACLE_REVISION_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kAdapterRevision[] = \"@REFERENCE_ADAPTER_REVISION_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kAdapterContentSha256[] = \"@REFERENCE_ADAPTER_CONTENT_SHA256_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kCmakePreset[] = \"@REFERENCE_PRESET_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kCompilerId[] = \"@REFERENCE_COMPILER_ID_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kCompilerVersion[] = \"@REFERENCE_COMPILER_VERSION_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kTarget[] = \"@REFERENCE_TARGET_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kBuildType[] = \"@REFERENCE_BUILD_TYPE_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kEffectiveCompileFlags[] = \"@REFERENCE_PUBLIC_COMPILE_SUMMARY_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kEffectiveLinkFlags[] = \"@REFERENCE_PUBLIC_LINK_SUMMARY_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kSanitizerMode[] = \"@REFERENCE_SANITIZER_MODE_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kCompileCommandSha256[] = \"${COMPILE_COMMAND_SHA256}\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kTargetTriple[] = \"@REFERENCE_TARGET_TRIPLE_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kTargetCpu[] = \"@REFERENCE_TARGET_CPU_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kTargetFeatures[] = \"@REFERENCE_TARGET_FEATURES_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kSdkOrSysroot[] = \"@REFERENCE_SDK_OR_SYSROOT_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kOptimization[] = \"@REFERENCE_OPTIMIZATION_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kFpModel[] = \"@REFERENCE_FP_MODEL_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kFpContract[] = \"@REFERENCE_FP_CONTRACT_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kDenormalMode[] = \"@REFERENCE_DENORMAL_MODE_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kFeatureSet[] = \"@REFERENCE_FEATURE_SET_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kOs[] = \"@REFERENCE_OS_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kLibc[] = \"@REFERENCE_LIBC_CPP@\";\n")
file(APPEND "${OUTPUT_HEADER}" "inline constexpr char kLibm[] = \"@REFERENCE_LIBM_CPP@\";\n\n")
file(APPEND "${OUTPUT_HEADER}" "}  // namespace liquidfun::reference::configured_build_identity\n")
